#!/usr/bin/env bash
# ==============================================================================
# Cadence Xcelium (xrun) Parallel Simulation Runner - COMPRESSION Mode
# Transition Delay ATPG Patterns
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WORKDIR="$SCRIPT_DIR"

PARALLEL_DIR="$WORKDIR/testresults/verilog_parallel"
MAINSIM="$PARALLEL_DIR/VER.COMPRESSION.cv32e40p_core_compression.mainsim.v"
LOG_FILE="$WORKDIR/ncverilog_COMPRESSION_parallel.log"

if [ ! -f "$MAINSIM" ]; then
    echo "ERROR: Parallel main simulation file not found: $MAINSIM"
    echo "Please run 'runmodus.atpg.tcl' first to generate parallel vectors."
    exit 1
fi

# Dynamically gather all testfiles in testresults/verilog_parallel
TESTFILE_ARGS=()
idx=1
for tf in $(ls "$PARALLEL_DIR"/VER.COMPRESSION.cv32e40p_core_compression.data.*.verilog 2>/dev/null | sort); do
    TESTFILE_ARGS+=("+TESTFILE${idx}=${tf}")
    idx=$((idx + 1))
done

if [ ${#TESTFILE_ARGS[@]} -eq 0 ]; then
    for tf in $(ls "$PARALLEL_DIR"/*.verilog 2>/dev/null | sort); do
        TESTFILE_ARGS+=("+TESTFILE${idx}=${tf}")
        idx=$((idx + 1))
    done
fi

echo "=== Running Parallel Xcelium Simulation for Transition Delay (COMPRESSION) ==="
echo "Testfiles: ${TESTFILE_ARGS[*]}"

xrun \
   +access+rwc \
   +xmstatus \
   +xm64bit \
   "${TESTFILE_ARGS[@]}" \
   +HEARTBEAT \
   +FAILSET \
   +xmtimescale+1ns/1ps \
   +xmoverride_timescale \
   +xmseq_udp_delay+2ps \
   +libext+.v+.V+.z+.Z+.gz \
   -l "$LOG_FILE" \
   -v /home/admin/DFT/Library/atpg/stdcell.v \
   "$WORKDIR/cv32e40p_core.test_netlist.v" \
   "$MAINSIM"

echo "=== Parallel Simulation Completed! Log: $LOG_FILE ==="
