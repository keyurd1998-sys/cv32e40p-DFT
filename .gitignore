# Genus checkpoints and binary databases
scan/dbs/*.db
scan/dbs/*
!scan/dbs/.gitkeep
dbs/*.db
dbs/*
!dbs/.gitkeep

# Modus ATPG binary testbench data and simulation results
atpg/**/tbdata/
atpg/**/testresults/
**/tbdata/
**/testresults/

# Simulation artifacts (GLS)
gls/xcelium.d/
gls/simv*
gls/*.vcd
gls/*.shm/
gls/waves/*
!gls/waves/.gitkeep

# Cadence tool runtime clutter
fv/
fvl_work/
*.cmd*
*.log[0-9]*
.cadence/
.genus/
.modus/
modus_work/

# System and temporary editor files
*.tmp
*~
*.swp
*.swo
.DS_Store
Thumbs.db
